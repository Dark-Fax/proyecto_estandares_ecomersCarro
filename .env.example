# Variables de entorno para Proyecto Web E‑Comers Carros
# Copie este archivo a .env y complete los valores

# Conexión a Azure SQL Database
DB_SERVER=su_servidor.database.windows.net
DB_NAME=su_base_de_datos
DB_USER=su_usuario
DB_PASS=su_contraseña

# Clave secreta para sesiones y seguridad de Flask
SECRET_KEY=una_clave_secreta_muy_segura_cambiar_en_produccion

# Modo debug (True para desarrollo, False para producción)
DEBUG=True

# API Key para Open Charge Map (obtener en https://openchargemap.org/site/develop/api)
API_OCM_KEY=su_api_key_de_openchargemap

# Otras variables opcionales
# FLASK_APP=run.py
# FLASK_ENV=developmentSECRET_KEY=cambia-esto
FORCE_HTTPS=0
# DATABASE_URL=sqlite:///:memory:   (solo para pruebas)


# --- Recuperación de contraseña por correo (RF-14). Si falta alguna de las tres, se usa el modo desarrollo
#     (el enlace se muestra en pantalla). Para Gmail use una "contraseña de aplicación".
# MAIL_SERVER=smtp.gmail.com
# MAIL_USER=su_correo@gmail.com
# MAIL_PASS=su_contraseña_de_aplicacion
# MAIL_PORT=587          # 587 = STARTTLS (por defecto); 465 = SSL directo
# MAIL_FROM=Planeta Verde <su_correo@gmail.com>

# --- Seguridad / despliegue
# FORCE_HTTPS=1          # cookie de sesión con atributo Secure (detrás de HTTPS)
# ADMIN_PASSWORD=ClaveSegura123   # contraseña del admin creado por el seed
